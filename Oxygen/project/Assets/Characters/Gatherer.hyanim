# Gatherer: idle and walk clips for each facing. The sheet has one 6-frame cycle per facing,
# so Walk plays the same frames faster than Idle.
SpriteAnimationSet:
  Texture: Villagers.png
  DefaultClip: IdleDown
  Clips:
    - Name: IdleDown
      FrameRate: 6
      Loop: Loop
      Frames: [Gatherer_Down_0, Gatherer_Down_1, Gatherer_Down_2, Gatherer_Down_3, Gatherer_Down_4, Gatherer_Down_5]
    - Name: IdleRight
      FrameRate: 6
      Loop: Loop
      Frames: [Gatherer_Right_0, Gatherer_Right_1, Gatherer_Right_2, Gatherer_Right_3, Gatherer_Right_4, Gatherer_Right_5]
    - Name: IdleUp
      FrameRate: 6
      Loop: Loop
      Frames: [Gatherer_Up_0, Gatherer_Up_1, Gatherer_Up_2, Gatherer_Up_3, Gatherer_Up_4, Gatherer_Up_5]
    - Name: IdleLeft
      FrameRate: 6
      Loop: Loop
      Frames: [Gatherer_Left_0, Gatherer_Left_1, Gatherer_Left_2, Gatherer_Left_3, Gatherer_Left_4, Gatherer_Left_5]
    - Name: WalkDown
      FrameRate: 12
      Loop: Loop
      Frames: [Gatherer_Down_0, Gatherer_Down_1, Gatherer_Down_2, Gatherer_Down_3, Gatherer_Down_4, Gatherer_Down_5]
    - Name: WalkRight
      FrameRate: 12
      Loop: Loop
      Frames: [Gatherer_Right_0, Gatherer_Right_1, Gatherer_Right_2, Gatherer_Right_3, Gatherer_Right_4, Gatherer_Right_5]
    - Name: WalkUp
      FrameRate: 12
      Loop: Loop
      Frames: [Gatherer_Up_0, Gatherer_Up_1, Gatherer_Up_2, Gatherer_Up_3, Gatherer_Up_4, Gatherer_Up_5]
    - Name: WalkLeft
      FrameRate: 12
      Loop: Loop
      Frames: [Gatherer_Left_0, Gatherer_Left_1, Gatherer_Left_2, Gatherer_Left_3, Gatherer_Left_4, Gatherer_Left_5]
